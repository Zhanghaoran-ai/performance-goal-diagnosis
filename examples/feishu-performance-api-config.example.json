{
  "base_url": "https://open.feishu.cn",
  "permission_level": 2,
  "timeout_seconds": 30,
  "max_response_bytes": 10485760,
  "auth": {
    "type": "tenant_access_token",
    "app_id_env": "FEISHU_APP_ID",
    "app_secret_env": "FEISHU_APP_SECRET",
    "token_path": "/open-apis/auth/v3/tenant_access_token/internal",
    "token_response_path": "tenant_access_token"
  },
  "success": {
    "path": "code",
    "equals": 0,
    "message_path": "msg"
  },
  "endpoints": {
    "users": {
      "method": "GET",
      "path": "/请替换为已获授权的人员接口",
      "items_path": "data.items",
      "query": {
        "department_id": "{department_id}"
      },
      "pagination": {
        "page_size_param": "page_size",
        "page_size": 100,
        "request_token_param": "page_token",
        "response_token_path": "data.page_token",
        "has_more_path": "data.has_more",
        "max_pages": 100
      }
    },
    "performance": {
      "mode": "list",
      "method": "GET",
      "path": "/请替换为用户提供的飞书绩效接口",
      "items_path": "data.items",
      "query": {
        "cycle_id": "{cycle_id}"
      },
      "pagination": {
        "page_size_param": "page_size",
        "page_size": 100,
        "request_token_param": "page_token",
        "response_token_path": "data.page_token",
        "has_more_path": "data.has_more",
        "max_pages": 100
      }
    }
  },
  "mappings": {
    "performance_item_mode": "goal_with_indicators",
    "indicators_path": "indicators",
    "user": {
      "user_id": ["user_id", "open_id", "employee_id"],
      "name": ["name", "display_name"],
      "department": ["department.name", "department_name"],
      "manager_id": ["manager_id", "leader_id"],
      "level": ["level", "job_level"]
    },
    "goal": {
      "goal_id": ["goal_id", "objective_id", "id"],
      "title": ["title", "objective_name", "name"],
      "owner_id": ["owner_id", "user_id"],
      "owner_name": ["owner_name", "user_name"],
      "parent_goal_ids": ["parent_goal_ids", "parent_ids"],
      "aligned_to_goal_ids": ["aligned_to_goal_ids", "aligned_goal_ids"],
      "level": ["level", "goal_level"],
      "progress": {"path": "progress", "cast": "float"}
    },
    "indicator": {
      "indicator_id": ["indicator_id", "metric_id", "id"],
      "name": ["name", "indicator_name", "metric_name"],
      "value": ["target_value", "value"],
      "unit": "unit",
      "parent_indicator_ids": ["parent_indicator_ids", "parent_metric_ids"]
    }
  }
}
